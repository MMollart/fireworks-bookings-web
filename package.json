{
  "name": "fireworks-bookings-web",
  "version": "1.0.0",
  "description": "Fireworks Bookings rebuilt as a Scout Budget-style web app with admin-managed sign-in and encrypted data at rest.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check": "wrangler deploy --dry-run"
  },
  "keywords": [
    "fireworks",
    "bookings",
    "scout-budget",
    "tickets",
    "events",
    "ticketsource"
  ],
  "author": "MMollart",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
