# Fireworks Bookings Web Configuration

# Server
PORT=3000
NODE_ENV=development

# Session & Security
# Generate a strong 32+ character random string for production
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars

# Data Encryption at Rest (AES-256-GCM)
# 64-char hex string representing 32 bytes (generate with `openssl rand -hex 32`)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
DATABASE_PATH=./data/fireworks.db

# Initial Admin User (created automatically if no users exist)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeMeNow123!

# TicketSource Integration (optional)
TICKETSOURCE_API_KEY=
TICKETSOURCE_API_URL=https://api.ticketsource.co.uk
